{% comment %}
ARCHIVIST V10.2 collection section.
One-time theme install; after that each product automatically reads the
archivist.layout_signature metafield written by the Shopify adapter.
{% endcomment %}
<section class="arc-collage page-width">
  {% if section.settings.heading != blank %}<h2 class="arc-collage__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  <div class="arc-collage__grid">
    {% assign source_collection = section.settings.collection %}
    {% for product in source_collection.products limit: section.settings.products_to_show %}
      {% assign sig = product.metafields.archivist.layout_signature | default: 'border-break' %}
      <a class="arc-card arc-card--{{ sig | escape }}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {% if product.featured_media %}
          {{ product.featured_media | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'arc-card__image', alt: product.featured_media.alt | default: product.title }}
        {% endif %}
        <div class="arc-card__meta">
          <span>{{ product.title | escape }}</span>
          <span>{{ product.price | money }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
<style>
.arc-collage__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-flow:dense;gap:clamp(8px,1.2vw,18px)}
.arc-card{position:relative;overflow:hidden;min-height:280px;background:#111;color:#f4f1ea;text-decoration:none;grid-column:span 4;aspect-ratio:1/1}
.arc-card__image{width:100%;height:100%;object-fit:cover;display:block;transition:transform .55s cubic-bezier(.2,.7,.2,1)}
.arc-card:hover .arc-card__image{transform:scale(1.025)}
.arc-card__meta{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-between;gap:16px;padding:12px 14px;background:linear-gradient(transparent,rgba(0,0,0,.72));font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.arc-card--border-break{grid-column:span 5;aspect-ratio:5/4}.arc-card--offset-contact-sheet{grid-column:span 3;aspect-ratio:3/4}.arc-card--split-frame{grid-column:span 4;aspect-ratio:1/1}.arc-card--editorial-overlap{grid-column:span 5;aspect-ratio:4/5}.arc-card--vertical-filmstrip{grid-column:span 3;aspect-ratio:2/3}.arc-card--corner-window{grid-column:span 4;aspect-ratio:4/3}
@media(max-width:749px){.arc-card,.arc-card--border-break,.arc-card--offset-contact-sheet,.arc-card--split-frame,.arc-card--editorial-overlap,.arc-card--vertical-filmstrip,.arc-card--corner-window{grid-column:span 6;aspect-ratio:1/1}.arc-collage__grid{gap:8px}}
</style>
{% schema %}
{"name":"ARCHIVIST collage grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Latest studies"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":2,"max":24,"step":1,"default":12,"label":"Products"}],"presets":[{"name":"ARCHIVIST collage grid"}]}
{% endschema %}
