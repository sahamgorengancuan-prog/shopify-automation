# ARCHIVIST — copy to .env and fill in what you have.
# Nothing here is mandatory: with no keys the pipeline runs in offline mode
# using synthetic references. Keys never leave this machine and are never
# written into a run manifest, a prompt file or a log line.

# --- credentials -----------------------------------------------------------
# https://api.bfl.ai — required to generate artwork
BFL_API_KEY=
# https://www.pexels.com/api/ — optional, adds contemporary photography
PEXELS_API_KEY=
# https://platform.openai.com/api-keys — optional creative assist (GPT-5.1)
# Judges discovered topics (wearability, angle, durability, rights risk) and
# sharpens the art direction.
OPENAI_API_KEY=

# --- discovery (all optional) ----------------------------------------------
# Google Trends and DuckDuckGo need no key at all — they are the backbone.
# Reddit answers anonymously from most IPs; add an app if yours is blocked:
# https://www.reddit.com/prefs/apps  (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=archivist/1.0 (trend discovery)
# X API v2, paid tier: https://developer.x.com
X_BEARER_TOKEN=
# Instagram Graph — needs a business/creator account:
# https://developers.facebook.com/docs/instagram-api/guides/hashtag-search
META_ACCESS_TOKEN=
META_IG_USER_ID=

# --- models ----------------------------------------------------------------
# flux-kontext-max | flux-kontext-pro | flux-pro-1.1-ultra | flux-pro-1.1 | flux-dev
BFL_MODEL=flux-kontext-max
BFL_FALLBACK_MODEL=flux-pro-1.1-ultra
OPENAI_MODEL=gpt-5.1
# point this at any OpenAI-compatible gateway if you use one
OPENAI_BASE_URL=https://api.openai.com/v1
# none | low | medium | high — how much the model thinks before answering
OPENAI_REASONING_EFFORT=low

# --- pipeline defaults -----------------------------------------------------
ARCHIVIST_COLLECTION=default
ARCHIVIST_RUNS_DIR=runs
ARCHIVIST_GARMENT=dark
ARCHIVIST_ASPECT_RATIO=3:4
ARCHIVIST_PRINT_WIDTH_IN=12
ARCHIVIST_PRINT_DPI=300

# --- mining ----------------------------------------------------------------
ARCHIVIST_MAX_QUERIES=24
ARCHIVIST_CANDIDATES_PER_QUERY=6
ARCHIVIST_MAX_CANDIDATES=60
ARCHIVIST_KEEP_REFERENCES=8
ARCHIVIST_MIN_REFERENCE_SCORE=5.5
ARCHIVIST_REQUEST_DELAY=0.8
ARCHIVIST_HTTP_TIMEOUT=45

# --- what the bot will accept as a topic -----------------------------------
# Where to read demand from: US, GB, ID, DE… blank searches worldwide
ARCHIVIST_TRENDS_GEO=US
# today 3-m | today 12-m | today 1-m | now 7-d
ARCHIVIST_TRENDS_TIMEFRAME=today 3-m
# Hard filters — a topic must clear all of them
ARCHIVIST_MIN_GROWTH=25
ARCHIVIST_MAX_COMPETITION=70
ARCHIVIST_MIN_SOCIAL=12
# How many candidates to measure, and how many opportunities to keep
ARCHIVIST_DISCOVERY_CANDIDATES=24
ARCHIVIST_DISCOVERY_KEEP=6
# How many of them autopilot actually designs per cycle
ARCHIVIST_AUTOPILOT_DESIGNS=1

# --- behaviour -------------------------------------------------------------
# 1 = never touch the network; synthetic references, no credits spent
ARCHIVIST_OFFLINE=0
# 0 = a fresh random seed each run; any other integer makes runs reproducible
ARCHIVIST_SEED=0
